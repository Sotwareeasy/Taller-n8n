{
  "name": "Reto 6 - PokeBot Telegram",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "id": "n1",
      "name": "Mensaje Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "credentials": {},
      "webhookId": "taller1-pokebot"
    },
    {
      "parameters": {
        "jsCode": "const m=$input.first().json.message;if(!m?.chat?.id||typeof m.text!=='string')return [];const a=/^\\/pokemon(?:@[a-zA-Z0-9_]+)?\\s+([a-zA-Z0-9-]+)\\s*$/.exec(m.text.trim());return [{json:{chat_id:m.chat.id,valido:!!a,pokemon:a?a[1].toLowerCase():'',ayuda:'Usa /pokemon seguido del nombre del Pokemon.'}}];"
      },
      "id": "n2",
      "name": "Interpretar comando",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "condition",
              "leftValue": "={{ $json.valido }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Comando valido",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ ($json.ayuda).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "n4",
      "name": "Mostrar ayuda",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        780,
        0
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "url": "={{ 'https://pokeapi.co/api/v2/pokemon/'+encodeURIComponent($json.pokemon) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "n5",
      "name": "Consultar PokeAPI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const r=$input.first().json;if(r.statusCode===404)return [{json:{encontrado:false,mensaje:'No se encontro ese Pokemon. Revisa el nombre e intenta de nuevo.'}}];if(r.statusCode!==200)throw Error('PokeAPI HTTP '+r.statusCode);const p=typeof r.body==='string'?JSON.parse(r.body):r.body;if(!p?.name||!Number.isInteger(p.id)||!Array.isArray(p.types)||!Array.isArray(p.abilities)||!Number.isFinite(p.height)||!Number.isFinite(p.weight))throw Error('Respuesta PokeAPI incompleta');const tipos=p.types.map(t=>t.type.name).join(', '),habilidades=p.abilities.map(a=>a.ability.name).join(', ');return [{json:{encontrado:true,nombre:p.name,id:p.id,tipos,altura_m:p.height/10,peso_kg:p.weight/10,habilidades,mensaje:'Nombre: '+p.name+'\\nID: '+p.id+'\\nTipos: '+tipos+'\\nAltura: '+p.height/10+' m\\nPeso: '+p.weight/10+' kg\\nHabilidades: '+habilidades}}];"
      },
      "id": "n6",
      "name": "Formatear respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        260
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Interpretar comando').first().json.chat_id }}",
        "text": "={{ ($json.mensaje).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "n7",
      "name": "Responder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        260,
        260
      ],
      "credentials": {}
    }
  ],
  "connections": {
    "Mensaje Telegram": {
      "main": [
        [
          {
            "node": "Interpretar comando",
